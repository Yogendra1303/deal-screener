"use client";

// Source documents for any deal: micro-badges that open a preview panel with a download button.
import { useCallback, useEffect, useMemo, useState } from "react";
import { archiveById } from "@/lib/archive";
import { coverage } from "@/lib/coverage";
import { sampleById } from "@/lib/data";
import { DOC_TEXT, auditHtml, csvRows, deckFacts, deckSheetHtml, formJson, sheetCsv, slugFile, snapshotCsv, type DocCode, type SourceDoc } from "@/lib/docs";
import { findRegistry } from "@/lib/fixtures";
import { flowById, lastDeck } from "@/lib/flow";
import { loadDeck } from "@/lib/deckstore";
import { checkUploadCached } from "@/lib/upload";
import { useLinks } from "./links-store";
import { useStore } from "./store";
import { cx } from "./ui";

const json = (form: object) => JSON.stringify(form, null, 2) + "\n";
const SAMPLE_NOTE = "Fictional sample company. The deck and sheet are test files made for this prototype.";

/** Every source document for one deal, real files first. Works for test decks, uploads and the archived history. */
export function useDocs() {
  const store = useStore();
  const links = useLinks();
  return useCallback(
    (id: string): SourceDoc[] => {
      const d = store.getDeal(id);
      const s = sampleById(id);
      const inb = links.getInbound(id);
      const h = flowById(id);
      const out: SourceDoc[] = [];
      if (d || s) {
        const form = d?.form ?? s!.form;
        const name = form.companyName;
        const slug = slugFile(name);
        const deckUrl = d?.deck.url ?? (s ? `/samples/${s.deckFile}` : null);
        out.push(
          deckUrl
            ? { code: "DECK", title: "Pitch deck", fileName: d?.deck.fileName ?? s!.deckFile, mime: "application/pdf", view: "pdf", origin: s ? SAMPLE_NOTE : "Uploaded deck.", url: deckUrl }
            : { code: "DECK", title: "Pitch deck", fileName: d!.deck.fileName, mime: "application/pdf", view: "pdf", origin: "Uploaded deck, kept in this browser.", storeKey: id },
        );
        if (s?.sheetFile) out.push({ code: "CSV", title: "Monthly sheet", fileName: s.sheetFile, mime: "text/csv", view: "csv", origin: SAMPLE_NOTE, url: `/samples/${s.sheetFile}` });
        else if (d?.sheet?.length) out.push({ code: "CSV", title: "Monthly sheet", fileName: `${slug}-monthly.csv`, mime: "text/csv", view: "csv", origin: "The monthly rows read from the founder's sheet.", make: () => sheetCsv(d.sheet!) });
        out.push({ code: "FORM", title: "Intake form", fileName: `${slug}-intake.json`, mime: "application/json", view: "json", origin: "What the founder entered on the pitch form.", make: () => formJson(form) });
        const reg = d?.registry ?? findRegistry(name);
        if (reg) out.push({ code: "REG", title: "Registry record", fileName: `${slug}-registry.json`, mime: "application/json", view: "json", origin: "Sample registry record (fictional). No live registry is connected.", make: () => json(reg) });
        const cover = d ? coverage({ record: d.record, form: d.form, sheet: d.sheet, registry: d.registry, flags: d.flags }) : null;
        out.push({
          code: "AUDIT",
          title: "Audit report",
          fileName: `${slug}-audit.html`,
          mime: "text/html",
          view: "html",
          origin: d ? "Made from the check results on this deal." : "This deck has not been read yet, so the report says so.",
          make: () => auditHtml({ name, cover, sources: out.filter((x) => x.code !== "AUDIT").map((x) => DOC_TEXT[x.code]), note: d ? "Numbers read by the AI, checked by code." : "Not screened yet. Nothing has been compared." }),
        });
        return out;
      }
      if (inb) {
        const name = inb.form.companyName;
        const slug = slugFile(name);
        const m = inb.manual;
        const up = m ? checkUploadCached(id, inb.form, m) : null;
        const pdf = inb.files.find((f) => /\.pdf$/i.test(f.name));
        const csv = inb.files.find((f) => /\.csv$/i.test(f.name));
        if (pdf?.key) out.push({ code: "DECK", title: "Pitch deck", fileName: pdf.name, mime: "application/pdf", view: "pdf", origin: "Uploaded deck, kept in this browser.", storeKey: pdf.key });
        else
          out.push({
            code: "DECK",
            title: "Deck summary",
            fileName: `${slug}-deck-summary.html`,
            mime: "text/html",
            view: "html",
            origin: "The sample deck file is not shipped, so this summary is made from the intake details.",
            make: () =>
              deckSheetHtml({
                name,
                line: inb.oneLiner ?? `${inb.form.sector}, ${inb.form.stage}`,
                facts: up ? deckFacts(up.record) : [],
                meta: [["Sector", inb.form.sector], ["Stage", inb.form.stage], ["Country", inb.form.country], ["Deck file", pdf?.name ?? "Not on file"]],
                note: "Made by Fund Hub from the intake details. Sample data.",
              }),
          });
        if (csv?.key) out.push({ code: "CSV", title: "Monthly sheet", fileName: csv.name, mime: "text/csv", view: "csv", origin: "Uploaded sheet, kept in this browser.", storeKey: csv.key });
        else if (m?.sheet) out.push({ code: "CSV", title: "Monthly sheet", fileName: m.sheetFile ?? `${slug}-monthly.csv`, mime: "text/csv", view: "csv", origin: "The monthly rows parsed from the uploaded sheet.", make: () => sheetCsv(m.sheet!) });
        if (up) out.push({ code: "CSV", title: "Deck figures", fileName: `${slug}-deck-figures.csv`, mime: "text/csv", view: "csv", origin: `Numbers typed from the deck by ${m!.by}.`, make: () => snapshotCsv(name, up.record, m!.asOf, `Typed from the deck by ${m!.by}`) });
        out.push({ code: "FORM", title: "Intake form", fileName: `${slug}-intake.json`, mime: "application/json", view: "json", origin: "The details entered with the pitch.", make: () => formJson(inb.form, m ? { subCategory: m.sub, city: m.city, founders: m.founders } : {}) });
        out.push({
          code: "AUDIT",
          title: "Audit report",
          fileName: `${slug}-audit.html`,
          mime: "text/html",
          view: "html",
          origin: up ? "Made from the code checks on the typed numbers and the sheet." : "This deck has not been read yet, so the report says so.",
          make: () => auditHtml({ name, cover: up?.cover ?? null, sources: out.filter((x) => x.code !== "AUDIT").map((x) => DOC_TEXT[x.code]), note: up ? `Deck numbers typed by ${m!.by}; sheet parsed by code; checks run by code.` : "Not screened yet." }),
        });
        return out;
      }
      if (h) {
        const a = archiveById(id)!;
        const slug = slugFile(h.name);
        const last = lastDeck(h);
        const note = "Archived deal record. These figures are fictional sample data made for the prototype, then checked by the same code as live decks.";
        out.push({
          code: "DECK",
          title: "Deck summary",
          fileName: `${slug}-deck-summary.html`,
          mime: "text/html",
          view: "html",
          origin: `Tear-sheet of the deck on file (${a.deckFile}). Sample data.`,
          make: () =>
            deckSheetHtml({
              name: h.name,
              line: `${h.sub} in ${h.city}.`,
              facts: deckFacts(a.record),
              meta: [["Sector", h.sector], ["Sub-category", h.sub], ["City", `${h.city}, ${h.country}`], ["Stage", last.stage], ["Deck on file", a.deckFile], ["Numbers as of", a.asOf]],
              note,
            }),
        });
        if (a.sheet) out.push({ code: "CSV", title: "Monthly sheet", fileName: a.sheetFile!, mime: "text/csv", view: "csv", origin: "Six months of sample figures for this archived deal.", make: () => sheetCsv(a.sheet!) });
        out.push({ code: "CSV", title: "Financial snapshot", fileName: `${slug}-snapshot.csv`, mime: "text/csv", view: "csv", origin: "The deck's stated numbers as one table. Sample data.", make: () => snapshotCsv(h.name, a.record, a.asOf, "Archived deck (sample)") });
        out.push({ code: "FORM", title: "Intake form", fileName: `${slug}-intake.json`, mime: "application/json", view: "json", origin: "Intake details on file. Sample data.", make: () => formJson(a.form) });
        out.push({
          code: "AUDIT",
          title: "Audit report",
          fileName: `${slug}-audit.html`,
          mime: "text/html",
          view: "html",
          origin: "Made from the code checks on the archived figures.",
          make: () => auditHtml({ name: h.name, cover: a.cover, sources: out.filter((x) => x.code !== "AUDIT").map((x) => DOC_TEXT[x.code]), note }),
        });
      }
      return out;
    },
    [store, links],
  );
}

async function blobOf(doc: SourceDoc): Promise<Blob | null> {
  if (doc.make) return new Blob([doc.make()], { type: doc.mime });
  if (doc.storeKey) return loadDeck(doc.storeKey);
  if (doc.url) {
    const r = await fetch(doc.url);
    return r.ok ? r.blob() : null;
  }
  return null;
}

export async function downloadDoc(doc: SourceDoc): Promise<boolean> {
  const blob = await blobOf(doc);
  if (!blob) return false;
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = doc.fileName;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 2000);
  return true;
}

export const MICRO = "inline-flex items-center rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] uppercase leading-none tracking-wider text-slate-600";

/** Monochrome badges, one per document. Each opens the preview panel. */
export function DocBadges({ docs, onOpen, className }: { docs: SourceDoc[]; onOpen: (i: number) => void; className?: string }) {
  const seen = new Set<DocCode>();
  return (
    <span className={cx("flex flex-wrap gap-1", className)}>
      {docs.map((d, i) => {
        if (seen.has(d.code)) return null;
        seen.add(d.code);
        return (
          <button
            key={d.code}
            type="button"
            onClick={(e) => {
              e.preventDefault();
              e.stopPropagation();
              onOpen(i);
            }}
            title={`${d.title}: ${d.fileName}. Click to preview or download.`}
            className={cx(MICRO, "hover:border-slate-400 hover:bg-white hover:text-slate-900")}
          >
            {({ DECK: "📄", CSV: "📊", FORM: "📝", REG: "🏛️", AUDIT: "✅" } as Record<string, string>)[d.code]} {d.code}
          </button>
        );
      })}
    </span>
  );
}

/** Slide-over panel: one tab per document, a preview, and a download button. */
export function DocDrawer({ name, docs, start, onClose }: { name: string; docs: SourceDoc[]; start: number; onClose: () => void }) {
  const [i, setI] = useState(start);
  const doc = docs[i];
  const [body, setBody] = useState<{ text?: string; url?: string; failed?: boolean } | null>(null);
  const [msg, setMsg] = useState<string | null>(null);

  useEffect(() => {
    let alive = true;
    let made: string | null = null;
    (async () => {
      if (!doc) return;
      if (doc.view === "pdf") {
        if (doc.url) return alive && setBody({ url: doc.url });
        const b = await blobOf(doc);
        if (!alive) return;
        if (!b) return setBody({ failed: true });
        made = URL.createObjectURL(b);
        setBody({ url: made });
        return;
      }
      const b = await blobOf(doc);
      if (!alive) return;
      setBody(b ? { text: await b.text() } : { failed: true });
    })();
    return () => {
      alive = false;
      setBody(null);
      if (made) URL.revokeObjectURL(made);
    };
  }, [doc]);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onClose]);

  if (!doc) return null;
  return (
    <div className="fixed inset-0 z-50 flex justify-end" role="dialog" aria-modal="true" aria-label={`${name} documents`}>
      <button aria-label="Close" onClick={onClose} className="absolute inset-0 bg-slate-900/30" />
      <div className="relative flex h-full w-full max-w-2xl flex-col bg-white shadow-2xl">
        <div className="border-b border-slate-200 px-5 pb-3 pt-4">
          <div className="flex items-start justify-between gap-3">
            <div className="min-w-0">
              <p className="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Source documents</p>
              <h2 className="truncate text-lg font-semibold text-slate-900">{name}</h2>
            </div>
            <button onClick={onClose} className="rounded-md px-2 py-1 text-sm text-slate-500 hover:bg-slate-100 hover:text-slate-900">
              ✕ Close
            </button>
          </div>
          <div className="mt-3 flex flex-wrap gap-1.5">
            {docs.map((d, k) => (
              <button
                key={d.fileName}
                onClick={() => {
                  setI(k);
                  setMsg(null);
                }}
                className={cx(
                  "rounded-md border px-2 py-1 text-xs font-medium",
                  k === i ? "border-slate-900 bg-slate-900 text-white" : "border-slate-200 bg-white text-slate-700 hover:border-slate-300",
                )}
              >
                <span className="mr-1.5 font-mono text-[10px] uppercase tracking-wider opacity-70">{d.code}</span>
                {d.title}
              </button>
            ))}
          </div>
        </div>
        <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 bg-slate-50 px-5 py-2.5">
          <div className="min-w-0 text-xs text-slate-600">
            <span className="font-mono text-slate-800">{doc.fileName}</span>
            <span className="block text-slate-500">{doc.origin}</span>
          </div>
          <div className="flex shrink-0 gap-2">
            {doc.view === "html" && body?.text && (
              <button
                onClick={() => {
                  const w = window.open("", "_blank");
                  if (!w) return;
                  w.document.write(body.text!);
                  w.document.close();
                  w.focus();
                  w.print();
                }}
                className="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-slate-400"
              >
                Print / Save as PDF
              </button>
            )}
            <button
              onClick={async () => setMsg((await downloadDoc(doc)) ? null : "This file is not in this browser any more.")}
              className="rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800"
            >
              Download file ↓
            </button>
          </div>
        </div>
        {msg && <p className="px-5 py-2 text-xs text-rose-700">{msg}</p>}
        <div className="min-h-0 flex-1 overflow-auto">
          {!body ? (
            <p className="p-5 text-sm text-slate-500">Loading…</p>
          ) : body.failed ? (
            <p className="p-5 text-sm text-slate-600">This file is not stored in this browser, so it can&apos;t be shown. It may have been uploaded in another browser.</p>
          ) : doc.view === "pdf" ? (
            <iframe title={doc.fileName} src={body.url} className="h-full w-full" />
          ) : doc.view === "html" ? (
            <iframe title={doc.fileName} srcDoc={body.text} className="h-full w-full" sandbox="" />
          ) : doc.view === "csv" ? (
            <CsvTable text={body.text ?? ""} />
          ) : (
            <pre className="whitespace-pre-wrap break-words p-5 font-mono text-xs leading-relaxed text-slate-800">{body.text}</pre>
          )}
        </div>
      </div>
    </div>
  );
}

function CsvTable({ text }: { text: string }) {
  const rows = csvRows(text);
  const [head, ...rest] = rows;
  if (!head) return <p className="p-5 text-sm text-slate-500">Empty file.</p>;
  const numeric = head.map((_, c) => rest.length > 0 && rest.every((r) => !r[c] || /^-?[\d.,]+%?$/.test(r[c])));
  return (
    <div className="p-5">
      <table className="w-full text-left text-xs">
        <thead>
          <tr className="border-b border-slate-200 text-[10px] uppercase tracking-wider text-slate-500">
            {head.map((h, c) => (
              <th key={c} className={cx("px-2 py-2 font-semibold", numeric[c] && "text-right")}>
                {h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rest.map((r, k) => (
            <tr key={k} className="border-b border-slate-100">
              {head.map((_, c) => (
                <td key={c} className={cx("px-2 py-1.5 text-slate-800", numeric[c] && "text-right tabular-nums")}>
                  {r[c]}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

/** Badges plus the panel, for a deal page header. */
export function DealDocs({ id, name, className }: { id: string; name: string; className?: string }) {
  const docsFor = useDocs();
  const docs = useMemo(() => docsFor(id), [docsFor, id]);
  const [open, setOpen] = useState<number | null>(null);
  const audit = docs.findIndex((d) => d.code === "AUDIT");
  return (
    <div className={cx("flex flex-wrap items-center gap-2", className)}>
      <span className="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Files</span>
      <DocBadges docs={docs} onOpen={setOpen} />
      <span className="flex-1" />
      <button onClick={() => setOpen(0)} className="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 hover:border-slate-400">
        Preview files
      </button>
      {audit >= 0 && (
        <button onClick={() => downloadDoc(docs[audit])} className="rounded-md bg-slate-900 px-2.5 py-1 text-xs font-semibold text-white hover:bg-slate-800">
          Download audit report ↓
        </button>
      )}
      {open != null && <DocDrawer name={name} docs={docs} start={open} onClose={() => setOpen(null)} />}
    </div>
  );
}
