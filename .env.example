# Copy this file to .env.local and fill in your key. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional: change the model or how hard it thinks (low, medium, high, xhigh, max)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Where saves go. With both of these set, every browser shares one database and one file store.
# Without them the app saves to data/runtime-db.json on this machine, or to the browser on a
# read-only host. Run supabase/schema.sql once in the Supabase SQL editor first.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Only if you use the anon key instead: uncomment the policies at the bottom of supabase/schema.sql.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_BUCKET=deal-files

# ---- Real sign-in (Google). Auth is enforced only when all three are set. ----
# AUTH_SECRET=            # generate with: npx auth secret   (or: openssl rand -base64 32)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Redirect URI to register in Google Cloud: https://<your-domain>/api/auth/callback/google
# Who may sign in is the public.permitted_users table in Supabase. Without Supabase, use these email lists:
# FUNDHUB_PARTNERS=you@fund.com,other@fund.com
# FUNDHUB_ANALYSTS=analyst@fund.com

# ---- Live lookups. With none of these set, the labelled sample fixtures are used instead. ----
# OPENCORPORATES_API_KEY=   # company registry: legal incorporation date
# CLEARBIT_API_KEY=         # fallback: founding year from the company website
# PROXYCURL_API_KEY=        # founder LinkedIn profiles (uses the LinkedIn URL on the intake form)
