# Copy this file to .env.local and fill in your key. Never commit .env.local.
ANTHROPIC_API_KEY=

# Optional: change the model or how hard it thinks (low, medium, high, xhigh, max)
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Where saves go. With both of these set, every browser shares one database and one file store.
# Without them the app saves to data/runtime-db.json on this machine, or to the browser on a
# read-only host. Run supabase/schema.sql once in the Supabase SQL editor first.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Only if you use the anon key instead: uncomment the policies at the bottom of supabase/schema.sql.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_BUCKET=deal-files
