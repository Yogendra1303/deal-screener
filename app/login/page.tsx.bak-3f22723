"use client";

import { useRouter } from "next/navigation";
import { useEffect, useState } from "react";
import { Avatar } from "@/components/shell";
import { cx } from "@/components/ui";
import { useWorkspace } from "@/components/workspace";
import { DEMO_ACCOUNTS } from "@/lib/auth";

export default function LoginPage() {
  const w = useWorkspace();
  const router = useRouter();
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (w.ready && w.session) router.replace("/");
  }, [w.ready, w.session, router]);

  function submit(e: React.FormEvent) {
    e.preventDefault();
    const err = w.signIn(email, password);
    setError(err);
    if (!err) router.replace("/");
  }

  return (
    <div className="grid min-h-full place-items-center px-4 py-10">
      <div className="w-full max-w-md space-y-6">
        <div className="flex items-center gap-2.5">
          <span className="grid h-9 w-9 place-items-center rounded-lg bg-slate-900 text-base font-bold text-white">F</span>
          <span className="leading-tight">
            <span className="block text-lg font-semibold text-slate-900">Fund Hub</span>
            <span className="block text-xs text-slate-500">Prototype · fictional sample data</span>
          </span>
        </div>

        <form onSubmit={submit} className="space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div>
            <h1 className="text-xl font-semibold tracking-tight text-slate-900">Sign in</h1>
            <p className="mt-1 text-sm text-slate-600">Partners see the whole fund and each analyst&apos;s work. Analysts see their own companies in depth.</p>
          </div>
          <label className="block text-sm">
            <span className="font-medium text-slate-700">Work email</span>
            <input
              type="email"
              autoComplete="username"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
              required
            />
          </label>
          <label className="block text-sm">
            <span className="font-medium text-slate-700">Password</span>
            <input
              type="password"
              autoComplete="current-password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
              required
            />
          </label>
          {error && (
            <p role="alert" className="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800 ring-1 ring-inset ring-red-200">
              {error}
            </p>
          )}
          <button type="submit" className="w-full rounded-lg bg-slate-900 px-3.5 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
            Sign in
          </button>
        </form>

        <section className="rounded-2xl border border-dashed border-slate-300 bg-white/70 p-4">
          <h2 className="text-sm font-semibold text-slate-900">Demo accounts</h2>
          <p className="mt-0.5 text-xs text-slate-500">Click one to fill the form.</p>
          <ul className="mt-3 space-y-2">
            {DEMO_ACCOUNTS.map((a) => (
              <li key={a.email}>
                <button
                  type="button"
                  onClick={() => {
                    setEmail(a.email);
                    setPassword(a.password);
                    setError(null);
                  }}
                  className={cx(
                    "flex w-full items-start gap-3 rounded-xl border bg-white p-3 text-left hover:border-indigo-300",
                    email === a.email ? "border-indigo-400 ring-1 ring-indigo-400" : "border-slate-200",
                  )}
                >
                  <Avatar name={a.name} size="md" />
                  <span className="min-w-0 text-sm">
                    <span className="flex flex-wrap items-baseline gap-x-2">
                      <span className="font-medium text-slate-900">{a.name}</span>
                      <span className="text-xs font-medium text-slate-500">{a.role}</span>
                    </span>
                    <span className="block font-mono text-xs text-slate-600">
                      {a.email} · {a.password}
                    </span>
                    <span className="mt-0.5 block text-xs text-slate-500">{a.sees}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <p className="mt-3 text-[11px] leading-snug text-slate-500">
            Demo sign-in only: it runs in this browser and is not security. A real version would use the fund&apos;s Google or Microsoft
            sign-in, with roles checked on the server.
          </p>
        </section>
      </div>
    </div>
  );
}
