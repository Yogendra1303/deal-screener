export type AgentStatus = "Live" | "Code only" | "Not built yet";

export interface Agent {
  name: string;
  job: string;
  reads: string[];
  suggests: string;
  approval: string;
  status: AgentStatus;
  statusNote: string;
}

export const AGENTS: Agent[] = [
  {
    name: "Screening",
    job: "Reads a new pitch into the standard record and checks it",
    reads: ["Deck", "Form", "Numbers sheet", "Registry", "Profiles"],
    suggests: "A filled record with page and quote for every fact, conflicts, strengths and concerns, questions for the founder, and a band",
    approval: "The band comes from written rules in code. A person sets the status and can overrule the band with a reason.",
    status: "Live",
    statusNote: "Runs when an API key is set. Ledgerly was screened in a Claude chat on this account instead.",
